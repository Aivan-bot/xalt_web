<!DOCTYPE html>
<html lang="de" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description }}">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="{{ site.url }}/css/main.css">
</head>
<body>

<!-- ===== HEADER ===== -->
<header class="header">
  <div class="hi">
    <!-- Logo -->
    <a href="{{ site.url }}" class="logo" aria-label="{{ site.name }} Startseite">
      <span class="lx">{{ site.name }}</span>
      <span class="ld"></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nn" id="mainNav" aria-label="Hauptnavigation">
      <div class="ni">
        <span class="nl">Leistungen <span class="d">▾</span></span>
        <div class="drop">
          <a href="{{ site.url }}/leistungen/atlassian-beratung/">Atlassian Beratung</a>
          <a href="{{ site.url }}/leistungen/digitale-transformation/">Digitale Transformation</a>
          <a href="{{ site.url }}/leistungen/agile-coaching/">Agile Transformation</a>
          <a href="{{ site.url }}/leistungen/platform-engineering/">Platform Engineering</a>
          <a href="{{ site.url }}/leistungen/atlassian-cloud-migration/">Cloud Migration</a>
        </div>
      </div>
      <div class="ni">
        <span class="nl">Lösungen <span class="d">▾</span></span>
        <div class="drop">
          <a href="{{ site.url }}/loesungen/digital-workplace/">Digital Workplace</a>
          <a href="{{ site.url }}/loesungen/prozess-digitalisierung/">Prozess Digitalisierung</a>
          <a href="{{ site.url }}/loesungen/cloud-infrastruktur/">Cloud Infrastruktur</a>
        </div>
      </div>
      <a href="{{ site.url }}/blog/" class="nl">Blog</a>
      <div class="ni">
        <span class="nl">Ressourcen <span class="d">▾</span></span>
        <div class="drop">
          <a href="{{ site.url }}/ressourcen/whitepaper/">Whitepaper</a>
          <a href="{{ site.url }}/ressourcen/webinar/">Webinar</a>
          <a href="{{ site.url }}/ressourcen/dokumentation/">Dokumentation</a>
        </div>
      </div>
      <div class="ni">
        <span class="nl">Unternehmen <span class="d">▾</span></span>
        <div class="drop">
          <a href="{{ site.url }}/unternehmen/ueber-uns/">Über uns</a>
          <a href="{{ site.url }}/unternehmen/karriere/">Karriere & Jobs</a>
          <a href="{{ site.url }}/unternehmen/unsere-teams/">Unser Team</a>
        </div>
      </div>
    </nav>

    <!-- Header Actions (Desktop: Search, Language, CTA) -->
    <div class="ha">
      <span class="srch" aria-label="Suche">⌕</span>
      <span class="lang" aria-label="Sprache wählen">🌐</span>
      <a href="{{ site.url }}/kontakt/" class="cta">Kontakt</a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button class="mt" id="menuToggle" aria-expanded="false" aria-controls="mobileDrop" aria-label="Menü öffnen">
      <span class="ml"></span>
      <span class="ml"></span>
      <span class="ml"></span>
    </button>
  </div>

  <!-- Mobile Menu Dropdown (flat link list) -->
  <div class="drop" id="mobileDrop" role="dialog" aria-label="Mobile Navigation" style="display:none">
    <a href="{{ site.url }}/leistungen/atlassian-beratung/">Atlassian Beratung</a>
    <a href="{{ site.url }}/leistungen/digitale-transformation/">Digitale Transformation</a>
    <a href="{{ site.url }}/leistungen/agile-coaching/">Agile Transformation</a>
    <a href="{{ site.url }}/leistungen/platform-engineering/">Platform Engineering</a>
    <a href="{{ site.url }}/leistungen/atlassian-cloud-migration/">Cloud Migration</a>
    <a href="{{ site.url }}/loesungen/digital-workplace/">Digital Workplace</a>
    <a href="{{ site.url }}/loesungen/prozess-digitalisierung/">Prozess Digitalisierung</a>
    <a href="{{ site.url }}/loesungen/cloud-infrastruktur/">Cloud Infrastruktur</a>
    <a href="{{ site.url }}/blog/">Blog</a>
    <a href="{{ site.url }}/ressourcen/whitepaper/">Whitepaper</a>
    <a href="{{ site.url }}/ressourcen/webinar/">Webinar</a>
    <a href="{{ site.url }}/ressourcen/dokumentation/">Dokumentation</a>
    <a href="{{ site.url }}/unternehmen/ueber-uns/">Über uns</a>
    <a href="{{ site.url }}/unternehmen/karriere/">Karriere & Jobs</a>
    <a href="{{ site.url }}/unternehmen/unsere-teams/">Unser Team</a>
    <a href="{{ site.url }}/kontakt/">Kontakt</a>
  </div>
</header>

<!-- ===== MAIN CONTENT ===== -->
{{ content }}

